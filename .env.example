# ═══════════════════════════════════════════════════
#   MERIT-TRADE AI — ENVIRONMENT CONFIGURATION
#   Copy this file to .env and fill in your values.
#   NEVER commit .env to source control.
# ═══════════════════════════════════════════════════

# ── App ──────────────────────────────────────────
APP_ENV=development
APP_NAME=MeritTradeAI
SECRET_KEY=CHANGE_ME_REPLACE_WITH_64_CHAR_SECRET
DEBUG=false

# ── PostgreSQL ────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=merittrade
POSTGRES_USER=merittrade_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://merittrade_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/merittrade

# ── Redis ─────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# ── RabbitMQ ──────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=merit_mq
RABBITMQ_PASSWORD=CHANGE_ME_MQ_PASSWORD
CELERY_BROKER_URL=amqp://merit_mq:CHANGE_ME_MQ_PASSWORD@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1

# ── JWT ───────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_256BIT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AES Encryption ────────────────────────────────
AES_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_AES256_KEY_HERE

# ── Anthropic API ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── MetaTrader 5 ──────────────────────────────────
# These are stored encrypted per user, NOT in env
MT5_SERVER_DEFAULT=MetaQuotes-Demo
MT5_TIMEOUT=10000

# ── Payment Providers ─────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

# Market Data
# Get free key at https://twelvedata.com (800 requests/day free)
# Required for forex pairs: EURUSD, GBPUSD, USDJPY, AUDUSD, XAUUSD
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# ── Notifications ─────────────────────────────────
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_TOKEN
SENDGRID_API_KEY=SG.CHANGE_ME
EMAIL_FROM=noreply@merittrade.ai
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE

# ── Rate Limiting ─────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=120

# ── Services Internal URLs ────────────────────────
AUTH_SERVICE_URL=http://auth-service:8001
USER_SERVICE_URL=http://user-service:8002
SIGNAL_ENGINE_URL=http://signal-engine:8003
MARKET_DATA_URL=http://market-data:8004
EXECUTION_ENGINE_URL=http://execution-engine:8005
RISK_ENGINE_URL=http://risk-engine:8006
NOTIFICATION_SERVICE_URL=http://notification-service:8007
ADMIN_SERVICE_URL=http://admin-service:8008

# ── Risk Defaults ─────────────────────────────────
DEFAULT_MAX_RISK_PER_TRADE=0.02
DEFAULT_MAX_DAILY_LOSS=0.05
DEFAULT_MAX_DRAWDOWN=0.15
MIN_CONFIDENCE_THRESHOLD=65

# ── ML Models ─────────────────────────────────────
MODEL_XGBOOST_PATH=/app/models/xgboost_v1.json
MODEL_LSTM_PATH=/app/models/lstm_v1.pt
MODEL_TRANSFORMER_PATH=/app/models/transformer_v1.pt
MODEL_SCALER_PATH=/app/models/scaler_v1.pkl

# ── CORS ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://app.merittrade.ai
